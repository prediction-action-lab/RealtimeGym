# Submit from the chtc directory with: condor_submit job_ft.sub

universe = container
container_image = docker://verlai/verl:vllm012.latest

executable = job_ft_snake.sh

log = snake_ft.log
output = snake_ft.out
error = snake_ft.err

stream_output = true
stream_error = true
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = .env, job_ft_snake.sh, ../RealtimeGym.tar.gz
# Checkpoints are copied to CHTC staging by job_ft_snake.sh. Do not copy the
# extracted project, model cache, or Python environment back to the submit dir.
transfer_output_files = ""

request_cpus = 8
request_memory = 160GB
request_disk = 200GB
request_gpus = 1

requirements = \
    (Target.CUDADriverVersion >= 12.1) && \
    (Target.HasCHTCStaging == true) && \
    (Target.GPUs_GlobalMemoryMb > 70000) && \
    (Target.Machine != "gpulab2004.chtc.wisc.edu")

+WantGPULab = false
+WantFlocking = false
+WantGlidein = false
+GPUJobLength = "short"

queue 1
